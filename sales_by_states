from pathlib import Path

import pandas as pd
import plotly.express as px

folder = Path(__file__).resolve().parent
file_path = folder / "e commerce project.csv.xlsx"
output_file = folder / "sales_by_state_map.html"

# The first row is a title; the second row contains the column headers.
df = pd.read_excel(
    file_path,
    sheet_name="cleaned data",
    header=1
)
df.columns = df.columns.str.strip()

# Convert sales to numbers and keep delivered orders.
df["sales"] = pd.to_numeric(df["sales"], errors="coerce")
delivered = df[
    df["Order Status"].astype(str).str.strip().str.lower().eq("delivered")
].dropna(subset=["State", "sales"]).copy()

# Convert full state names to two-letter map codes.
state_codes = {
    "Alabama": "AL", "Arizona": "AZ", "Arkansas": "AR",
    "California": "CA", "Colorado": "CO", "Connecticut": "CT",
    "Delaware": "DE", "Florida": "FL", "Georgia": "GA",
    "Idaho": "ID", "Illinois": "IL", "Indiana": "IN",
    "Iowa": "IA", "Kansas": "KS", "Kentucky": "KY",
    "Louisiana": "LA", "Maine": "ME", "Maryland": "MD",
    "Massachusetts": "MA", "Michigan": "MI", "Minnesota": "MN",
    "Mississippi": "MS", "Missouri": "MO", "Montana": "MT",
    "Nebraska": "NE", "Nevada": "NV", "New Hampshire": "NH",
    "New Jersey": "NJ", "New Mexico": "NM", "New York": "NY",
    "North Carolina": "NC", "North Dakota": "ND", "Ohio": "OH",
    "Oklahoma": "OK", "Oregon": "OR", "Pennsylvania": "PA",
    "Rhode Island": "RI", "South Carolina": "SC", "South Dakota": "SD",
    "Tennessee": "TN", "Texas": "TX", "Utah": "UT",
    "Vermont": "VT", "Virginia": "VA", "Washington": "WA",
    "West Virginia": "WV", "Wisconsin": "WI", "Wyoming": "WY",
    "Alaska": "AK", "Hawaii": "HI", "District of Columbia": "DC",
}

delivered["State Code"] = (
    delivered["State"].astype(str).str.strip().map(state_codes)
)

# Report any state names that could not be matched to the map.
unmatched = sorted(
    delivered.loc[delivered["State Code"].isna(), "State"].unique()
)
if unmatched:
    print("These state names were not recognized and will be skipped:", unmatched)

delivered = delivered.dropna(subset=["State Code"])

# Sum delivered sales by state.
sales_by_state = (
    delivered.groupby(["State", "State Code"], as_index=False)["sales"]
    .sum()
    .sort_values("sales", ascending=False)
)

# Create the state map.
fig = px.choropleth(
    sales_by_state,
    locations="State Code",
    locationmode="USA-states",
    color="sales",
    hover_name="State",
    hover_data={"State Code": False, "sales": ":,.2f"},
    color_continuous_scale="Blues",
    scope="usa",
    title="Sales by State — Delivered Orders",
    labels={"sales": "Sales"},
)

fig.show()
fig.write_html(output_file)
print(f"Interactive map saved to: {output_file}")